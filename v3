        return coords;
    };
    const WCODE = {0:['☀️','Clear'],1:['🌤️','Mostly Clear'],2:['⛅','Partly Cloudy'],3:['☁️','Overcast'],45:['🌫️','Fog'],48:['🌫️','Fog'],51:['🌦️','Drizzle'],53:['🌦️','Drizzle'],55:['🌦️','Drizzle'],61:['🌧️','Rain'],63:['🌧️','Rain'],65:['🌧️','Heavy Rain'],66:['🌧️','Freezing Rain'],67:['🌧️','Freezing Rain'],71:['🌨️','Snow'],73:['🌨️','Snow'],75:['🌨️','Heavy Snow'],77:['🌨️','Snow'],80:['🌦️','Showers'],81:['🌧️','Showers'],82:['⛈️','Heavy Showers'],85:['🌨️','Snow Showers'],86:['🌨️','Snow Showers'],95:['⛈️','Thunderstorm'],96:['⛈️','Thunderstorm'],99:['⛈️','Thunderstorm']};
