  /* ============================================================
     SEEK TO END
     ============================================================ */

  function forceSeekToEnd() {

    let found =
      false;


    getDocuments()
      .forEach(doc => {

        try {

          const seek =
            doc.querySelector(
              CONFIG.seekSelector
            );


          const range =
            doc.querySelector(
              CONFIG.progressSelector
            );


          if (
            !seek ||
            !range ||
            !isVisible(seek)
          ) {
            return;
          }


          found =
            true;


          /*
            Range input → maximum
          */

          const max =
            Number(
              range.max
            );


          if (
            Number.isFinite(max)
          ) {

            range.value =
              String(max);


            range.dispatchEvent(
              new Event(
                "input",
                {
                  bubbles: true
                }
              )
            );


            range.dispatchEvent(
              new Event(
                "change",
                {
                  bubbles: true
                }
              )
            );
          }


          /*
            Left click at far right.
          */

          const rect =
            seek.getBoundingClientRect();


          const x =
            rect.right - 3;


          const y =
            rect.top +
            rect.height / 2;


          const target =
            doc.elementFromPoint(
              x,
              y
            ) ||
            range;


          const view =
            doc.defaultView ||
            window;


          const down = {

            bubbles: true,

            cancelable: true,

            clientX: x,

            clientY: y,

            button: 0,

            buttons: 1,

            view
          };


          const up = {

            ...down,

            buttons: 0
          };


          target.dispatchEvent(
            new MouseEvent(
              "mousemove",
              down
            )
          );


          target.dispatchEvent(
            new MouseEvent(
              "mousedown",
              down
            )
          );


          target.dispatchEvent(
            new MouseEvent(
              "mouseup",
              up
            )
          );


          target.dispatchEvent(
            new MouseEvent(
              "click",
              up
            )
          );


        } catch (error) {

          console.warn(
            "[STEPP Up] Seek failed:",
            error
          );
        }

      });


    return found;
  }


  /* ============================================================
     AUTO TIMER
     ============================================================ */

  function clearAutoTimer() {

    if (autoTimer) {

      clearInterval(
        autoTimer
      );

      autoTimer =
        null;
    }
  }


  /* ============================================================
     AUTO NEXT STEP
     ============================================================ */

  async function runAutoNextStep() {

    if (
      destroyed ||
      !autoRequested ||
      interactionPaused ||
      autoStepBusy
    ) {
      return;
    }


    autoStepBusy =
      true;


    renderStatus();


    try {

      scanInteractions();


      if (
        interactionPaused
      ) {
        return;
      }


      forceSeekToEnd();


      await sleep(
        CONFIG.seekProcessingDelay
      );


      scanInteractions();


      if (
        destroyed ||
        !autoRequested ||
        interactionPaused
      ) {
        return;
      }


      nextScreen();


      presses++;


    } finally {

      autoStepBusy =
        false;


      renderStatus();
    }
  }


  function buildAutoTimer() {

    clearAutoTimer();


    if (
      !autoRequested ||
      interactionPaused ||
      destroyed
    ) {
      return;
    }


    autoTimer =
      setInterval(
        runAutoNextStep,
        Number(
          speed.value
        )
      );
  }


  /* ============================================================
     START / PAUSE
     ============================================================ */

  async function startAuto() {

    if (
      autoRequested ||
      destroyed
    ) {
      return;
    }


    autoRequested =
      true;


    interactionPaused =
      false;


    playPause.textContent =
      "⏸";


    playPause.title =
      "Pause Auto NEXT";


    playPause.classList
      .add("running");


    renderStatus();


    await runAutoNextStep();


    if (
      autoRequested &&
      !interactionPaused
    ) {

      buildAutoTimer();
    }
  }


  function pauseAuto() {

    autoRequested =
      false;


    clearAutoTimer();


    playPause.textContent =
      "▶";


    playPause.title =
      "Start Auto NEXT";


    playPause.classList
      .remove("running");


    renderStatus();
  }


  playPause
    .addEventListener(
      "click",
      () => {

        if (autoRequested) {

          pauseAuto();

        } else {

          startAuto();
        }
      }
    );


  /* ============================================================
     SPEED
     ============================================================ */

  function updateSpeed() {

    const ms =
      Number(
        speed.value
      );


    /*
      Seconds information ALWAYS remains.
    */

    secondsDisplay.textContent =
      `${(ms / 1000).toFixed(1)} sec`;


    const progress =
      (
        (
          ms -
          Number(speed.min)
        )

        /

        (
          Number(speed.max) -
          Number(speed.min)
        )
      )

      * 100;


    speed.style
      .setProperty(
        "--fill",
        `${progress}%`
      );


    if (
      autoRequested &&
      !interactionPaused
    ) {

      buildAutoTimer();
    }
  }


  speed
    .addEventListener(
      "input",
      updateSpeed
    );


  /* ============================================================
     FIND INTERACTION CONTROL
     ============================================================ */

  function findAssociatedControl(
    bg
  ) {

    if (!bg) {
      return null;
    }


    const selector = [

      "button",

      "[role='button']",

      "a[href]",

      "[onclick]",

      "[tabindex='0']",

      "[data-acc-text]",

      "[data-ref]",

      ".slide-object"

    ].join(",");


    try {

      const closest =
        bg.closest(
          selector
        );


      if (
        closest &&
        closest !== bg &&
        isVisible(closest)
      ) {

        return closest;
      }

    } catch (_) {}


    let container =
      bg;


    for (
      let level = 0;

      level < 10 &&
      container;

      level++
    ) {

      container =
        container.parentElement;


      if (!container) {
        break;
      }


      try {

        if (
          container.matches(
            selector
          ) &&
          isVisible(container)
        ) {

          return container;
        }

      } catch (_) {}


      try {

        const candidates =
          [
            ...container
              .querySelectorAll(
                selector
              )
          ];


        const candidate =
          candidates.find(
            item =>
              item !== bg &&
              isVisible(item)
          );


        if (candidate) {

          return candidate;
        }

      } catch (_) {}
    }


    return null;
  }


  /* ============================================================
     LEFT CLICK
     ============================================================ */

  function simulateLeftClick(
    element
  ) {

    if (!element) {
      return false;
    }


    try {

      const rect =
        element.getBoundingClientRect();


      const x =
        rect.left +
        rect.width / 2;


      const y =
        rect.top +
        rect.height / 2;


      const win =
        element.ownerDocument
          ?.defaultView ||
        window;


      const down = {

        bubbles: true,

        cancelable: true,

        clientX: x,

        clientY: y,

        button: 0,

        buttons: 1,

        view: win
      };


      const up = {

        ...down,

        buttons: 0
      };


      element.dispatchEvent(
        new MouseEvent(
          "mouseover",
          down
        )
      );


      element.dispatchEvent(
        new MouseEvent(
          "mousedown",
          down
        )
      );


      element.dispatchEvent(
        new MouseEvent(
          "mouseup",
          up
        )
      );


      element.dispatchEvent(
        new MouseEvent(
          "click",
          up
        )
      );


      return true;

    } catch (error) {

      console.warn(
        "[STEPP Up] Interaction click failed:",
        error
      );


      return false;
    }
  }


  /* ============================================================
     INTERACTION PROCESSING
     ============================================================ */

  async function processInteraction(
    bg
  ) {

    if (
      destroyed ||
      handledInteractions.has(bg) ||
      !isVisible(bg)
    ) {
      return;
    }


    handledInteractions.add(
      bg
    );


    const resumeAfter =
      autoRequested;


    if (resumeAfter) {

      interactionPaused =
        true;


      clearAutoTimer();


      renderStatus();
    }


    await sleep(
      CONFIG.interactionRenderDelay
    );


    let control =
      null;


    for (
      let attempt = 0;

      attempt <
      CONFIG.interactionSearchAttempts;

      attempt++
    ) {

      control =
        findAssociatedControl(
          bg
        );


      if (control) {
        break;
      }


      await sleep(
        CONFIG.interactionSearchDelay
      );
    }


    if (!control) {

      interactionPaused =
        resumeAfter;


      renderStatus();


      return;
    }


    setTemporaryStatus(
      "Selecting interaction…",
      900
    );


    const success =
      simulateLeftClick(
        control
      );


    if (!success) {

      interactionPaused =
        resumeAfter;


      renderStatus();


      return;
    }


    await sleep(
      CONFIG.interactionResumeDelay
    );


    if (
      resumeAfter &&
      !destroyed
    ) {

      interactionPaused =
        false;


      renderStatus();


      buildAutoTimer();
    }
  }


  /* ============================================================
     SCAN
     ============================================================ */

  function scanInteractions() {

    if (destroyed) {
      return false;
    }


    detectXOnPage();


    let interactionFound =
      false;


    getDocuments()
      .forEach(doc => {

        try {

          doc
            .querySelectorAll(
              CONFIG.interactionSelector
            )
            .forEach(bg => {

              if (
                isVisible(bg) &&
                !handledInteractions.has(bg)
              ) {

                interactionFound =
                  true;


                processInteraction(
                  bg
                );
              }

            });

        } catch (_) {}

      });


    renderStatus();


    return interactionFound;
  }


  /* ============================================================
     OBSERVER
     ============================================================ */

  observer =
    new MutationObserver(
      scanInteractions
    );


  observer.observe(
    document.documentElement,
    {
      childList: true,

      subtree: true,

      attributes: true,

      attributeFilter: [
        "class",
        "style",
        "hidden",
        "aria-hidden"
      ]
    }
  );


  scannerTimer =
    setInterval(
      scanInteractions,
      CONFIG.scanInterval
    );


  /* ============================================================
     DRAG
     ============================================================ */

  const drag =
    $("drag");


  let dragging =
    false;


  let offsetX =
    0;


  let offsetY =
    0;


  drag.addEventListener(
    "pointerdown",
    event => {

      if (
        event.target.closest(
          "button"
        )
      ) {
        return;
      }


      dragging =
        true;


      const rect =
        host
          .getBoundingClientRect();


      offsetX =
        event.clientX -
        rect.left;


      offsetY =
        event.clientY -
        rect.top;


      try {

        drag.setPointerCapture(
          event.pointerId
        );

      } catch (_) {}
    }
  );


  drag.addEventListener(
    "pointermove",
    event => {

      if (!dragging) {
        return;
      }


      const x =
        Math.max(
          0,
          Math.min(
            window.innerWidth -
            host.offsetWidth,

            event.clientX -
            offsetX
          )
        );


      const y =
        Math.max(
          0,
          Math.min(
            window.innerHeight -
            host.offsetHeight,

            event.clientY -
            offsetY
          )
        );


      host.style.left =
        `${x}px`;


      host.style.top =
        `${y}px`;


      host.style.right =
        "auto";
    }
  );


  drag.addEventListener(
    "pointerup",
    () => {

      dragging =
        false;

    }
  );


  drag.addEventListener(
    "pointercancel",
    () => {

      dragging =
        false;

    }
  );


  /* ============================================================
     DESTROY
     ============================================================ */

  function destroy() {

    if (destroyed) {
      return;
    }


    destroyed =
      true;


    clearAutoTimer();


    if (scannerTimer) {

      clearInterval(
        scannerTimer
      );
    }


    if (clockTimer) {

      clearInterval(
        clockTimer
      );
    }


    if (temporaryStatusTimer) {

      clearTimeout(
        temporaryStatusTimer
      );
    }


    if (observer) {

      observer.disconnect();
    }


    host.remove();


    delete window
      .__STEPPUp;
  }


  $("close")
    .addEventListener(
      "click",
      destroy
    );


  /* ============================================================
     MANUAL CONSOLE COMMANDS
     ============================================================ */

  window.__STEPPUp = {

    start:
      startAuto,

    pause:
      pauseAuto,

    next:
      nextScreen,

    mute:
      toggleMute,

    seek:
      forceSeekToEnd,

    scan:
      scanInteractions,

    destroy
  };


  /* ============================================================
     STARTUP
     ============================================================ */

  updateSpeed();

  scanInteractions();

  renderStatus();


  console.log(
    "%cSTEPP Up loaded",
    `
      background:#202024;
      color:#fff;
      padding:6px 10px;
      border-radius:8px;
      font-weight:600;
    `
  );

})();
