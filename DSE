  const $ =
    id =>
      shadow.getElementById(id);


  const nextBtn =
    $("next");


  const muteBtn =
    $("mute");


  const speed =
    $("speed");


  const speedText =
    $("speedText");


  const autoBtn =
    $("auto");


  const status =
    $("status");


  const dot =
    $("dot");


  let timer = null;

  let presses = 0;



  function flash(button) {

    button.classList
      .remove("flash");

    void button.offsetWidth;

    button.classList
      .add("flash");
  }



  function setStatus(text) {

    status.textContent =
      text;
  }



  /* ============================================================
     BUTTON ACTIONS
     ============================================================ */

