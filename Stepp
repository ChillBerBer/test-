  function getDocuments() {
    const docs = [];

    const seen =
      new Set();


    function walk(doc) {
      if (
        !doc ||
        seen.has(doc)
      ) {
        return;
      }

      seen.add(doc);

      docs.push(doc);


      try {
        doc
          .querySelectorAll("iframe")
          .forEach(frame => {

            try {
              if (frame.contentDocument) {
                walk(
                  frame.contentDocument
                );
              }
            } catch (_) {}

          });

      } catch (_) {}
    }


    walk(document);

    return docs;
  }


  function isVisible(element) {
    if (!element) {
      return false;
    }

    try {
      const rect =
        element.getBoundingClientRect();

      const win =
        element.ownerDocument
          ?.defaultView ||
        window;

      const style =
        win.getComputedStyle(
          element
        );


      return (
        rect.width > 0 &&
        rect.height > 0 &&
        style.display !== "none" &&
        style.visibility !== "hidden" &&
        Number(style.opacity || 1) > 0
      );

    } catch (_) {
      return false;
    }
  }


  /* ============================================================
     KEYBOARD EVENTS
     ============================================================ */

  function makeKeyEvent(
    type,
    key,
    code,
    keyCode
  ) {
    const event =
      new KeyboardEvent(
        type,
        {
          key,
          code,

          // Control
          ctrlKey: true,

          // Option
          altKey: true,

          shiftKey: false,

          metaKey: false,

          bubbles: true,

          cancelable: true,

          composed: true
        }
      );


    try {
      Object.defineProperty(
        event,
        "keyCode",
        {
          get: () =>
            keyCode
        }
      );


      Object.defineProperty(
        event,
        "which",
        {
          get: () =>
            keyCode
        }
      );

    } catch (_) {}


    return event;
  }


  function sendShortcut(
    key,
    code,
    keyCode
  ) {
    getDocuments()
      .forEach(doc => {

        const targets = [
          doc.activeElement,
          doc.body,
          doc.documentElement,
          doc
        ].filter(Boolean);


        targets.forEach(target => {

          try {
            target.dispatchEvent(
              makeKeyEvent(
                "keydown",
                key,
                code,
                keyCode
              )
            );
          } catch (_) {}

        });


        try {
          doc.defaultView
            ?.dispatchEvent(
              makeKeyEvent(
                "keydown",
                key,
                code,
                keyCode
              )
            );
        } catch (_) {}


        setTimeout(
          () => {

            targets.forEach(
              target => {

                try {
                  target.dispatchEvent(
                    makeKeyEvent(
                      "keyup",
                      key,
                      code,
                      keyCode
                    )
                  );
                } catch (_) {}

              }
            );


