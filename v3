            const desc = c.weatherDesc[0].value.toLowerCase();
            let icon = '☀️'; if (desc.includes('rain')) icon = '🌧️'; else if (desc.includes('cloud')) icon = '☁️';
            wxData = { city: area.areaName[0].value, temp: Math.round(temp), feels: Math.round(c.FeelsLikeF), desc: c.weatherDesc[0].value, icon, humidity: c.humidity, wind: c.windspeedMiles + ' mph', uv: c.uvIndex, aqi: '--', rain: c.chanceofrain, sunrise: j.weather[0].astronomy[0].sunrise, sunset: j.weather[0].astronomy[0].sunset, unit: state.config.weatherUnit, hourly: [], daily: [], alert: '' };
