    "click",
    nextScreen
  );


  muteBtn.addEventListener(
    "click",
    toggleMute
  );



  /* ============================================================
     SPEED
     ============================================================ */

  function updateSpeed() {

    const milliseconds =
      Number(speed.value);


    const perSecond =
      1000 /
      milliseconds;


    speedText.textContent =

      perSecond >= 1

        ? `${perSecond.toFixed(1)} / sec`

        : `${(
            milliseconds /
            1000
          ).toFixed(2)} sec`;


    const progress =

      (
        (
          milliseconds -
          Number(speed.min)
        )

        /

        (
          Number(speed.max) -
          Number(speed.min)
        )
      )

      * 100;


    speed.style
      .setProperty(
        "--position",
        `${progress}%`
      );


    if (timer) {

      clearInterval(timer);

      timer =
        setInterval(
          () => {

            nextScreen();

            presses++;

          },

          milliseconds
        );
    }
  }



  speed.addEventListener(
    "input",
    updateSpeed
  );



  /* ============================================================
     AUTO NEXT
     ============================================================ */

  function startAuto() {

    if (timer)
      return;


    presses = 0;


    nextScreen();

    presses++;


    timer =
      setInterval(
        () => {

          nextScreen();

          presses++;

        },

        Number(
          speed.value
        )
      );


    autoBtn.textContent =
      "■ Stop Auto NEXT";


    autoBtn.classList
      .add("running");


    dot.classList
      .add("active");


    setStatus(
      "Automatically pressing NEXT"
    );
  }



  function stopAuto() {

    if (timer) {

      clearInterval(timer);

      timer = null;
    }


    autoBtn.textContent =
      "▶ Start Auto NEXT";


    autoBtn.classList
      .remove("running");


    dot.classList
      .remove("active");


    setStatus(
      `Stopped • ${presses} NEXT presses`
    );
  }



  autoBtn.addEventListener(
    "click",
    () => {

      if (timer) {
        stopAuto();
      } else {
        startAuto();
      }

    }
  );



  /* ============================================================
     CLOSE
     ============================================================ */

  $("close")
    .addEventListener(
      "click",
      () => {

        stopAuto();

        host.remove();

      }
    );



  /* ============================================================
     DRAGGING
     ============================================================ */

  const drag =
    $("drag");


  let dragging =
    false;


  let offsetX =
    0;


  let offsetY =
    0;



  drag.addEventListener(
    "pointerdown",
    event => {

      if (
        event.target
          .closest("button")
      ) {
        return;
      }


      dragging =
        true;


      const rect =
        host.getBoundingClientRect();


      offsetX =
        event.clientX -
        rect.left;


      offsetY =
        event.clientY -
        rect.top;


      drag.setPointerCapture(
        event.pointerId
      );

    }
  );



  drag.addEventListener(
    "pointermove",
    event => {

      if (!dragging)
        return;


      const x =
        Math.max(
          0,

          Math.min(

            window.innerWidth -
            host.offsetWidth,

            event.clientX -
            offsetX
          )
        );


      const y =
        Math.max(
          0,

          Math.min(

            window.innerHeight -
            host.offsetHeight,

            event.clientY -
            offsetY
          )
        );


      host.style.left =
        `${x}px`;


      host.style.top =
        `${y}px`;


      host.style.right =
        "auto";

    }
  );



  drag.addEventListener(
    "pointerup",
    () => {

      dragging =
        false;

    }
  );



  drag.addEventListener(
    "pointercancel",
    () => {

      dragging =
        false;

    }
  );



