        off.x = e.clientX; off.y = e.clientY; clampWidget();
    });
    document.addEventListener('mouseup', () => isDragging = false);

    let rz = false, rzX = 0, rzY = 0, rzW = 0, rzH = 0;
    widget.querySelector('#resize-grip').addEventListener('mousedown', (e) => {
        rz = true; rzX = e.clientX; rzY = e.clientY; const r = widget.getBoundingClientRect(); rzW = r.width; rzH = r.height;
        e.stopPropagation(); e.preventDefault();
    });
    document.addEventListener('mousemove', (e) => {
        if (!rz) return;
        const w = Math.max(320, rzW + (e.clientX - rzX)), h = Math.max(160, rzH + (e.clientY - rzY));
        widget.style.width = w + 'px'; widget.style.height = h + 'px'; state.config.winW = w; state.config.winH = h;
    });
    document.addEventListener('mouseup', () => { if (rz) { rz = false; saveSettings(); clampWidget(); } });

    // ================= DESTROY =================
    function destroy() {
        try { intervals.forEach(clearInterval); } catch (e) {}
        clearTimeout(state.timer); clearTimeout(state.nextCycle);
        try { clearInterval(state.cdseTimer); } catch (e) {}
        document.removeEventListener('keydown', keyHandler);
        window.removeEventListener('resize', clampWidget);
        try { widget.remove(); } catch (e) {}
        try { tab.remove(); } catch (e) {}
        try { styleTag.remove(); } catch (e) {}
        delete window.__clippy;
    }
    window.__clippy = { destroy, version: state.config.version };

    // ================= INIT + RESUME =================
    renderCerts(); renderAbout(); renderCertFilter(); initSpeed(); updateDetected();
    if (state.simpleMode) toggleSimple();
    const sess = loadSession();
    if (sess && Date.now() - sess.ts < 6 * 3600e3) {
        setTimeout(() => {
            if (sess.cdse) startCdse();
            else if (sess.mode === 'jko' && sess.running) runJKO();
            else if (state.simpleMode) autoRunDetected();
            else if (sess.mode === 'opsec' && sess.running) runOpsec();
        }, 1500);
    }
    console.log('%cClippy.B ' + state.config.version, 'background:#202024;color:#fff;padding:6px 10px;border-radius:8px;font-weight:600;');
})();
