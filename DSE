  /* ============================================================
     COURSE CONTROL FUNCTIONS
     ============================================================ */

  function getDocuments() {
    const docs = [document];

    function scanFrames(doc) {
      try {
        const frames = doc.querySelectorAll("iframe");

        frames.forEach(frame => {
          try {
            if (frame.contentDocument) {
              docs.push(frame.contentDocument);
              scanFrames(frame.contentDocument);
            }
          } catch (_) {}
        });
      } catch (_) {}
    }

    scanFrames(document);

    return [...new Set(docs)];
  }


  /* ------------------------------------------------------------
     CREATE A LEGACY-COMPATIBLE KEYBOARD EVENT

     Storyline courses often look for:
       event.keyCode
       event.which

     instead of only event.key
     ------------------------------------------------------------ */

  function createKeyEvent(type, key, code, keyCode) {
    const event = new KeyboardEvent(type, {
      key,
      code,

      ctrlKey: true,

      // On macOS:
      // altKey = Option
      altKey: true,

      shiftKey: false,
      metaKey: false,

      bubbles: true,
      cancelable: true,
      composed: true
    });

    /*
      KeyboardEvent keyCode/which are normally read-only.
      Define them manually for older course software.
    */

    try {
      Object.defineProperty(event, "keyCode", {
        get: () => keyCode
      });

      Object.defineProperty(event, "which", {
        get: () => keyCode
      });

      Object.defineProperty(event, "charCode", {
        get: () => 0
      });
    } catch (_) {}

    return event;
  }


  function dispatchShortcut(key, code, keyCode) {
    const docs = getDocuments();

    docs.forEach(doc => {
      const targets = [
        doc.activeElement,
        doc.body,
        doc.documentElement,
        doc
      ].filter(Boolean);

      targets.forEach(target => {
        try {
          target.dispatchEvent(
            createKeyEvent(
              "keydown",
              key,
              code,
              keyCode
            )
          );
        } catch (_) {}
      });

      /*
        Some Storyline courses attach the keyboard
        listener to window instead of document.
      */

      try {
        const win = doc.defaultView;

        win?.dispatchEvent(
          createKeyEvent(
            "keydown",
            key,
            code,
            keyCode
          )
        );
      } catch (_) {}


      setTimeout(() => {
        targets.forEach(target => {
          try {
            target.dispatchEvent(
              createKeyEvent(
                "keyup",
                key,
                code,
                keyCode
              )
            );
          } catch (_) {}
        });

        try {
          doc.defaultView?.dispatchEvent(
            createKeyEvent(
              "keyup",
              key,
              code,
              keyCode
            )
          );
        } catch (_) {}

      }, 35);
    });
  }


  /* ============================================================
     FIND COURSE BUTTON
     ============================================================ */

  function findClickable(words) {
    const docs = getDocuments();

    for (const doc of docs) {
      const elements = doc.querySelectorAll(`
        button,
        [role="button"],
        a,
        [onclick],
        [tabindex],
        svg,
        div
      `);

      for (const element of elements) {
        try {
          const parts = [
            element.innerText,
            element.textContent,
            element.getAttribute("aria-label"),
            element.getAttribute("title"),
            element.getAttribute("data-acc-text"),
            element.getAttribute("data-title"),
            element.id,
            element.className
          ]
            .filter(Boolean)
            .join(" ")
            .toLowerCase();


          const matched = words.some(word =>
            parts.includes(word.toLowerCase())
          );


          if (matched) {
            const rect =
              element.getBoundingClientRect?.();

            if (
              rect &&
              rect.width > 0 &&
              rect.height > 0
            ) {
              return element;
            }
          }

        } catch (_) {}
      }
    }

    return null;
  }


  function clickElement(element) {
    if (!element) return false;

    try {
      element.dispatchEvent(
        new MouseEvent("mousedown", {
          bubbles: true,
          cancelable: true,
          view: window
        })
      );

      element.dispatchEvent(
        new MouseEvent("mouseup", {
          bubbles: true,
          cancelable: true,
          view: window
        })
      );

      element.click();

      return true;

    } catch (_) {
      return false;
    }
  }


