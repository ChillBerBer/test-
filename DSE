(() => {
  // Remove an existing copy if you paste the script again.
  document.getElementById("liquid-hotkey-widget")?.remove();

  const host = document.createElement("div");
  host.id = "liquid-hotkey-widget";
  host.style.cssText = `
    all: initial;
    position: fixed;
    top: 90px;
    right: 30px;
    z-index: 2147483647;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
      "SF Pro Text", "Segoe UI", sans-serif;
  `;

  const shadow = host.attachShadow({ mode: "open" });

  shadow.innerHTML = `
    <style>
      * {
        box-sizing: border-box;
      }

      .glass {
        width: 330px;
        color: rgba(255,255,255,.96);
        background:
          linear-gradient(
            145deg,
            rgba(35,35,40,.72),
            rgba(12,12,15,.62)
          );
        border: 1px solid rgba(255,255,255,.16);
        border-radius: 28px;
        box-shadow:
          0 28px 70px rgba(0,0,0,.48),
          inset 0 1px 0 rgba(255,255,255,.20),
          inset 0 -1px 0 rgba(255,255,255,.04);
        backdrop-filter: blur(30px) saturate(180%);
        -webkit-backdrop-filter: blur(30px) saturate(180%);
        overflow: hidden;
        user-select: none;
      }

      .shine {
        position: absolute;
        pointer-events: none;
        inset: 0;
        border-radius: inherit;
        background:
          radial-gradient(
            180px 110px at 15% 0%,
            rgba(255,255,255,.13),
            transparent 70%
          );
      }

      .header {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 17px 18px 13px;
        cursor: grab;
      }

      .header:active {
        cursor: grabbing;
      }

      .title {
        font-size: 16px;
        font-weight: 650;
        letter-spacing: -.25px;
      }

      .subtitle {
        margin-top: 2px;
        font-size: 11px;
        color: rgba(255,255,255,.48);
      }

      .close {
        appearance: none;
        border: 1px solid rgba(255,255,255,.12);
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: rgba(255,255,255,.07);
        color: rgba(255,255,255,.72);
        font-size: 17px;
        cursor: pointer;
        transition: .18s ease;
      }

      .close:hover {
        background: rgba(255,255,255,.15);
        color: white;
        transform: scale(1.06);
      }

      .content {
        position: relative;
        padding: 4px 17px 18px;
      }

      .actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 11px;
        margin-bottom: 15px;
      }

      .action {
        appearance: none;
        position: relative;
        height: 92px;
        border-radius: 22px;
        border: 1px solid rgba(255,255,255,.12);
        color: white;
        background:
          linear-gradient(
            145deg,
            rgba(255,255,255,.115),
            rgba(255,255,255,.045)
          );
        box-shadow:
          inset 0 1px 0 rgba(255,255,255,.12),
          0 10px 25px rgba(0,0,0,.14);
        cursor: pointer;
        overflow: hidden;
        transition:
          transform .16s ease,
          background .16s ease,
          border-color .16s ease;
      }

      .action:hover {
        transform: translateY(-2px);
        background:
          linear-gradient(
            145deg,
            rgba(255,255,255,.17),
            rgba(255,255,255,.075)
          );
        border-color: rgba(255,255,255,.20);
      }

      .action:active {
        transform: scale(.97);
      }

      .bigIcon {
        display: block;
        margin-bottom: 7px;
        font-size: 26px;
        line-height: 1;
        font-weight: 500;
      }

      .label {
        font-size: 12px;
        font-weight: 600;
      }

      .keys {
        margin-top: 3px;
        font-size: 9.5px;
        color: rgba(255,255,255,.43);
      }

      .panel {
        padding: 15px;
        background: rgba(255,255,255,.055);
        border: 1px solid rgba(255,255,255,.10);
        border-radius: 21px;
        box-shadow: inset 0 1px 0 rgba(255,255,255,.08);
      }

      .speedRow {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
      }

      .speedTitle {
        font-size: 12px;
        font-weight: 600;
      }

      .speedValue {
        font-size: 11px;
        font-variant-numeric: tabular-nums;
        color: rgba(255,255,255,.57);
      }

      input[type="range"] {
        appearance: none;
        -webkit-appearance: none;
        width: 100%;
        height: 6px;
        border-radius: 99px;
        outline: none;
        cursor: pointer;
        background:
          linear-gradient(
            90deg,
            rgba(255,255,255,.95) var(--progress, 18%),
            rgba(255,255,255,.16) var(--progress, 18%)
          );
      }

      input[type="range"]::-webkit-slider-thumb {
        appearance: none;
        -webkit-appearance: none;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: white;
        box-shadow:
          0 2px 8px rgba(0,0,0,.4),
          0 0 0 4px rgba(255,255,255,.08);
      }

      input[type="range"]::-moz-range-thumb {
        width: 20px;
        height: 20px;
        border: none;
        border-radius: 50%;
        background: white;
        box-shadow:
          0 2px 8px rgba(0,0,0,.4),
          0 0 0 4px rgba(255,255,255,.08);
      }

      .scale {
        display: flex;
        justify-content: space-between;
        margin-top: 8px;
        margin-bottom: 14px;
        color: rgba(255,255,255,.30);
        font-size: 9px;
      }

      .auto {
        appearance: none;
        width: 100%;
        height: 44px;
        border: 1px solid rgba(255,255,255,.13);
        border-radius: 15px;
        color: white;
        background: rgba(255,255,255,.10);
        font-size: 12px;
        font-weight: 650;
        cursor: pointer;
        transition: .2s ease;
      }

      .auto:hover {
        background: rgba(255,255,255,.16);
      }

      .auto.running {
        background: rgba(255,70,70,.20);
        border-color: rgba(255,85,85,.32);
      }

      .status {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        margin-top: 10px;
        height: 15px;
        font-size: 9.5px;
        color: rgba(255,255,255,.42);
      }

      .dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: rgba(255,255,255,.28);
        box-shadow: 0 0 0 transparent;
      }

      .dot.active {
        background: #5cff81;
        box-shadow: 0 0 10px rgba(92,255,129,.8);
      }

      .flash {
        animation: flash .18s ease;
      }

      @keyframes flash {
        0% {
          box-shadow: inset 0 0 0 0 rgba(255,255,255,0);
        }
        50% {
          box-shadow: inset 0 0 25px rgba(255,255,255,.17);
        }
        100% {
          box-shadow: inset 0 0 0 0 rgba(255,255,255,0);
        }
      }
    </style>

    <div class="glass">
      <div class="shine"></div>

      <div class="header" id="drag">
        <div>
          <div class="title">Shortcut Control</div>
          <div class="subtitle">Liquid Glass Console Widget</div>
        </div>

        <button class="close" id="close">×</button>
      </div>

      <div class="content">

        <div class="actions">
          <button class="action" id="period">
            <span class="bigIcon">•••</span>
            <div class="label">Period Command</div>
            <div class="keys">CTRL + ALT + .</div>
          </button>

          <button class="action" id="mute">
            <span class="bigIcon">🔇</span>
            <div class="label">Mute</div>
            <div class="keys">CTRL + ALT + M</div>
          </button>
        </div>

        <div class="panel">

          <div class="speedRow">
            <span class="speedTitle">Auto Press Speed</span>
            <span class="speedValue" id="speedValue"></span>
          </div>

          <input
            id="speed"
            type="range"
            min="100"
            max="3000"
            step="50"
            value="1000"
          />

          <div class="scale">
            <span>FAST</span>
            <span>SLOW</span>
          </div>

          <button class="auto" id="auto">
            ▶ Start Auto Press
          </button>

          <div class="status">
            <span class="dot" id="dot"></span>
            <span id="status">Ready</span>
          </div>

        </div>
      </div>
    </div>
  `;

  document.documentElement.appendChild(host);

  const $ = id => shadow.getElementById(id);

  const periodBtn = $("period");
  const muteBtn = $("mute");
  const speedSlider = $("speed");
  const speedValue = $("speedValue");
  const autoBtn = $("auto");
  const status = $("status");
  const dot = $("dot");

  let timer = null;
  let pressCount = 0;

  /*
   * Sends keyboard events to the currently focused element.
   *
   * IMPORTANT:
   * Browser-generated KeyboardEvents are synthetic (isTrusted === false).
   * A web page can choose to ignore synthetic keyboard input.
   */
  function sendShortcut(key, code) {
    const target =
      document.activeElement &&
      document.activeElement !== document.body
        ? document.activeElement
        : document;

    const options = {
      key,
      code,
      ctrlKey: true,
      altKey: true,
      shiftKey: false,
      metaKey: false,
      bubbles: true,
      cancelable: true,
      composed: true
    };

    target.dispatchEvent(new KeyboardEvent("keydown", options));
    target.dispatchEvent(new KeyboardEvent("keypress", options));
    target.dispatchEvent(new KeyboardEvent("keyup", options));
  }

  function pressPeriod() {
    sendShortcut(".", "Period");
    pressCount++;

    periodBtn.classList.remove("flash");
    void periodBtn.offsetWidth;
    periodBtn.classList.add("flash");
  }

  function pressMute() {
    sendShortcut("m", "KeyM");

    muteBtn.classList.remove("flash");
    void muteBtn.offsetWidth;
    muteBtn.classList.add("flash");

    status.textContent = "Ctrl + Alt + M sent";
  }

  function updateSpeedText() {
    const ms = Number(speedSlider.value);
    const perSecond = 1000 / ms;

    speedValue.textContent =
      perSecond >= 1
        ? `${perSecond.toFixed(1)} / sec`
        : `${(ms / 1000).toFixed(2)} sec`;

    const progress =
      ((ms - Number(speedSlider.min)) /
        (Number(speedSlider.max) - Number(speedSlider.min))) *
      100;

    speedSlider.style.setProperty("--progress", `${progress}%`);

    if (timer) {
      stopAuto();
      startAuto();
    }
  }

  function startAuto() {
    if (timer) return;

    pressCount = 0;

    timer = setInterval(
      pressPeriod,
      Number(speedSlider.value)
    );

    autoBtn.textContent = "■ Stop Auto Press";
    autoBtn.classList.add("running");
    dot.classList.add("active");

    status.textContent = "Auto pressing Ctrl + Alt + .";
  }

  function stopAuto() {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }

    autoBtn.textContent = "▶ Start Auto Press";
    autoBtn.classList.remove("running");
    dot.classList.remove("active");

    status.textContent =
      pressCount > 0
        ? `Stopped • ${pressCount} presses`
        : "Ready";
  }

  periodBtn.addEventListener("click", () => {
    pressPeriod();
    status.textContent = "Ctrl + Alt + . sent";
  });

  muteBtn.addEventListener("click", pressMute);

  autoBtn.addEventListener("click", () => {
    timer ? stopAuto() : startAuto();
  });

  speedSlider.addEventListener("input", updateSpeedText);

  $("close").addEventListener("click", () => {
    stopAuto();
    host.remove();
  });

  // --------------------------
  // DRAGGING
  // --------------------------

  const drag = $("drag");

  let dragging = false;
  let offsetX = 0;
  let offsetY = 0;

  drag.addEventListener("pointerdown", e => {
    if (e.target.closest("button")) return;

    dragging = true;

    const rect = host.getBoundingClientRect();

    offsetX = e.clientX - rect.left;
    offsetY = e.clientY - rect.top;

    drag.setPointerCapture(e.pointerId);
  });

  drag.addEventListener("pointermove", e => {
    if (!dragging) return;

    const x = Math.max(
      0,
      Math.min(
        window.innerWidth - host.offsetWidth,
        e.clientX - offsetX
      )
    );

    const y = Math.max(
      0,
      Math.min(
        window.innerHeight - host.offsetHeight,
        e.clientY - offsetY
      )
    );

    host.style.left = `${x}px`;
    host.style.top = `${y}px`;
    host.style.right = "auto";
  });

  drag.addEventListener("pointerup", () => {
    dragging = false;
  });

  updateSpeedText();

  console.log(
    "%cLiquid Glass Shortcut Widget loaded.",
    "font-weight:bold; color:#8af;"
  );
})();
