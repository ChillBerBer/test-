  function setTemporaryStatus(
    text,
    duration = 1200
  ) {

    temporaryStatus =
      text;


    renderStatus();


    if (temporaryStatusTimer) {

      clearTimeout(
        temporaryStatusTimer
      );
    }


    temporaryStatusTimer =
      setTimeout(
        () => {

          temporaryStatus =
            "";

          renderStatus();

        },

        duration
      );
  }


  function renderStatus() {

    dot.className =
      "dot";


    if (temporaryStatus) {

      statusText.textContent =
        temporaryStatus;

      dot.classList.add(
        "processing"
      );

      return;
    }


    if (interactionPaused) {

      statusText.textContent =
        xDetected
          ? "X detected • Paused"
          : "Interaction detected • Paused";


      dot.classList.add(
        xDetected
          ? "x"
          : "paused"
      );

      return;
    }


    if (xDetected) {

      statusText.textContent =
        "X detected on page";


      dot.classList.add(
        "x"
      );

      return;
    }


    if (autoRequested) {

      statusText.textContent =
        autoStepBusy
          ? "Processing…"
          : `Running • ${presses} NEXT`;


      dot.classList.add(
        autoStepBusy
          ? "processing"
          : "running"
      );

      return;
    }


    statusText.textContent =
      "Ready";
  }


  /* ============================================================
     DETECT X ON PAGE
     ============================================================ */

  function detectXOnPage() {

    let found =
      false;


    getDocuments()
      .some(doc => {

        try {

          const elements =
            doc.querySelectorAll(`
              button,
              [role="button"],
              [aria-label],
              [title],
              [data-acc-text]
            `);


          for (
            const element
            of elements
          ) {

            if (
              !isVisible(element)
            ) {
              continue;
            }


            const values = [

              element.textContent,

              element.getAttribute(
                "aria-label"
              ),

              element.getAttribute(
                "title"
              ),

              element.getAttribute(
                "data-acc-text"
              )

            ]
              .filter(Boolean)

              .map(value =>
                value
                  .trim()
                  .toLowerCase()
              );


            const match =
              values.some(value =>
                value === "x" ||
                value === "×" ||
                value === "close" ||
                value === "close button"
              );


            if (match) {

              found =
                true;

              break;
            }
          }


          return found;

        } catch (_) {

          return false;
        }

      });


    xDetected =
      found;


    return found;
  }


